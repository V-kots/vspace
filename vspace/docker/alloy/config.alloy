// Сбор логов VSpace → Loki (замена Promtail). Проект Compose: vspace (COMPOSE_PROJECT_NAME).

loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// --- Docker logs (кроме nginx: access/error из файлов) ---

discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

discovery.relabel "docker_filtered" {
	targets = discovery.docker.containers.targets

	rule {
		action        = "keep"
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "vspace"
	}

	rule {
		action        = "drop"
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "nginx"
	}

	rule {
		action        = "drop"
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "loki|promtail|alloy|prometheus|nginx-exporter|postgres-exporter|redis-exporter|php-fpm-exporter"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}

	rule {
		source_labels = ["__meta_docker_container_label_vspace_log_type"]
		regex         = "(.+)"
		target_label  = "log_type"
	}

	rule {
		source_labels = ["__meta_docker_container_label_vspace_log_type", "__meta_docker_container_label_com_docker_compose_service"]
		separator     = ";"
		regex         = "^;mysql$"
		target_label  = "log_type"
		replacement   = "mysql"
	}

	rule {
		source_labels = ["__meta_docker_container_label_vspace_log_type", "__meta_docker_container_label_com_docker_compose_service"]
		separator     = ";"
		regex         = "^;postgres$"
		target_label  = "log_type"
		replacement   = "postgres"
	}

	rule {
		source_labels = ["__meta_docker_container_label_vspace_log_type", "__meta_docker_container_label_com_docker_compose_service"]
		separator     = ";"
		regex         = "^;redis$"
		target_label  = "log_type"
		replacement   = "redis"
	}

	rule {
		source_labels = ["__meta_docker_container_label_vspace_log_type", "__meta_docker_container_label_com_docker_compose_service"]
		separator     = ";"
		regex         = "^;mailpit$"
		target_label  = "log_type"
		replacement   = "mail"
	}

	rule {
		source_labels = ["__meta_docker_container_label_vspace_log_type", "__meta_docker_container_label_com_docker_compose_service"]
		separator     = ";"
		regex         = "^;grafana$"
		target_label  = "log_type"
		replacement   = "grafana"
	}
}

loki.process "docker_logs" {
	forward_to = [loki.write.loki.receiver]

	stage.docker {}

	// Laravel JSON → log_type=app
	stage.match {
		selector = "{service=\"php\"}"

		stage.drop {
			expression = "^[^{]"
		}

		stage.json {
			expressions = {
				level   = "level_name",
				channel = "channel",
			}
		}

		stage.static_labels {
			values = {
				log_type = "app",
			}
		}

		stage.labels {
			values = {
				level   = "",
				channel = "",
			}
		}
	}

	// PHP-FPM stderr / access (не JSON)
	stage.match {
		selector = "{service=\"php\"}"

		stage.drop {
			expression = "^\\s*\\{"
		}

		stage.regex {
			expression = "^(?P<line>.*)"
		}

		stage.template {
			source   = "log_type"
			template = "{{ if regexMatch \"^\\\\d{1,3}(?:\\\\.\\\\d{1,3}){3} - \\\\S* \\\\d{2}/\\\\w{3}/\\\\d{4}:\\\\d{2}:\\\\d{2}:\\\\d{2} [+-]\\\\d{4} \\\\\\\"(?:GET|POST|HEAD|PUT|PATCH|DELETE|OPTIONS|CONNECT|TRACE) [^\\\\\\\"]+\\\\\\\" \\\\d{3}\\\\b\" .line }}phpfpm_access{{ else if regexMatch \"(fpm is running|ready to handle connections|\\\\[pool www\\\\]|NOTICE: \\\\[pool|WARNING: \\\\[pool|child \\\\d+ (started|stopped|exited))\" .line }}phpfpm{{ else }}error{{ end }}"
		}

		stage.labels {
			values = {
				log_type = "",
			}
		}
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.docker_filtered.output
	forward_to = [loki.process.docker_logs.receiver]
}

// --- Nginx access.log / error.log (формат vspace_main, vhost + rt) ---

local.file_match "nginx_logs" {
	path_targets = [
		{
			__address__ = "127.0.0.1",
			__path__    = "/var/log/nginx/access.log",
			service     = "nginx",
			log_type    = "access",
		},
		{
			__address__ = "127.0.0.1",
			__path__    = "/var/log/nginx/error.log",
			service     = "nginx",
			log_type    = "error",
		},
	]
}

loki.process "nginx_files" {
	forward_to = [loki.write.loki.receiver]

	stage.match {
		selector = "{log_type=\"access\"}"

		stage.regex {
			expression = " host=(?P<vhost>[^ ]+) rt="
		}

		stage.labels {
			values = {
				vhost = "",
			}
		}
	}

	stage.match {
		selector = "{log_type=\"access\", vhost=\"vspace.loc\"}"

		stage.regex {
			expression = "\" (?P<status>[0-9]{3}) (?P<body_bytes>[0-9]+|-) \""
		}

		stage.labels {
			values = {
				status = "",
			}
		}
	}
}

loki.source.file "nginx_files" {
	targets       = local.file_match.nginx_logs.targets
	forward_to    = [loki.process.nginx_files.receiver]
	// true при первой миграции с Promtail — не перечитывать гигабайт access.log (429 в Loki).
	// История уже в Loki; новые строки — с текущего offset в storage.path Alloy.
	tail_from_end = true
}
