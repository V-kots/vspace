# Copy to .env.docker and adjust for local dev
# docker compose --env-file .env.docker up -d --build

# Имя проекта Compose: префикс контейнеров, сеть ${COMPOSE_PROJECT_NAME}_net
COMPOSE_PROJECT_NAME=vspace

# Каталог данных томов (другой путь — если поднимаете вторую копию с другим COMPOSE_PROJECT_NAME)
COMPOSE_DATA_ROOT=./docker-data

VSPACE_DOMAIN=vspace.loc
GRAFANA_DOMAIN=grafana.vspace.loc
MAIL_DOMAIN=mail.vspace.loc

HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PUBLISH_PORT=5432

POSTGRES_DB=vspace
POSTGRES_USER=vspace
POSTGRES_PASSWORD=secret

# Пользователь потоковой репликации (создаётся на мастере автоматически)
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator-secret

# Localhost-порты для HeidiSQL/DBeaver. Наружу не публикуются.
POSTGRES_REPLICA_1_PORT=5433
POSTGRES_REPLICA_2_PORT=5434

# PgBouncer отключён: Laravel ходит напрямую в postgres / postgres-replica-*.
# PGBOUNCER_READ_1_PORT=6433
# PGBOUNCER_READ_2_PORT=6434

# Patroni (profile patroni, отдельный кластер)
PATRONI_SUPERUSER_PASSWORD=postgres
PATRONI_REPLICATION_PASSWORD=replicator-secret
PATRONI_APP_PASSWORD=secret
PATRONI_APP_DB=vspace
# HAProxy отключён: Laravel подключается напрямую к лидеру/репликам patroni-*.
# PATRONI_WRITE_PORT=5000
# PATRONI_READ_PORT=5001
# PATRONI_STATS_PORT=7000
# Сколько реплик должны подтвердить коммит в quorum-режиме.
# 1 из 3 узлов = кворум (лидер + 1 реплика). 2 = обе реплики.
PATRONI_SYNC_NODE_COUNT=1
# true — блокировать записи, если кворум недоступен.
PATRONI_SYNC_STRICT=false

# PgBouncer отключён (сервис закомментирован в docker-compose.yml).
# PGBOUNCER_PUBLISH_PORT=6432
# PGBOUNCER_POOL_MODE=transaction
# PGBOUNCER_MAX_CLIENT_CONN=1000
# PGBOUNCER_DEFAULT_POOL_SIZE=32
# PGBOUNCER_MAX_PREPARED_STATEMENTS=100

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Prometheus / cAdvisor / node-exporter (только localhost)
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100

# Xdebug 3 (сервис php). off | debug | develop | coverage | ...
XDEBUG_MODE=debug
XDEBUG_CONFIG=client_host=host.docker.internal client_port=9003

# OPcache (load / prod-like по умолчанию). Локальная правка PHP без рестарта: VALIDATE_TIMESTAMPS=1
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
# JIT: 1255 — tracing; 0 — выкл. После смены — docker compose up -d --build php
PHP_OPCACHE_JIT=1255
# Preload bootstrap/preload.php (нужен vendor/). 0 — отключить
PHP_OPCACHE_PRELOAD=1
PHP_FPM_MAX_CHILDREN=32
