      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "min": 0,
          "custom": {
            "axisBorderShow": true,
            "axisLabel": "req/s",
            "axisPlacement": "left",
            "axisSoftMin": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "499/s (client closed)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "504/s (gateway timeout)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "dark-red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 19,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({log_type=\"access\", service=\"nginx\", vhost=\"vspace.loc\", status=~\"4..\"}[1m]))",
          "legendFormat": "4xx/s",
          "refId": "A",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({log_type=\"access\", service=\"nginx\", vhost=\"vspace.loc\", status=\"499\"}[1m]))",
          "legendFormat": "499/s (client closed)",
          "refId": "B",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({log_type=\"access\", service=\"nginx\", vhost=\"vspace.loc\", status=\"502\"}[1m]))",
          "legendFormat": "502/s",
          "refId": "C",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({log_type=\"access\", service=\"nginx\", vhost=\"vspace.loc\", status=\"504\"}[1m]))",
          "legendFormat": "504/s (gateway timeout)",
          "refId": "D",
          "queryType": "range"
        }
      ],
      "title": "Nginx — 4xx / 499 / 502 / 504 (vspace.loc)",
      "description": "Loki (access labels). Серия 4xx/s включает 499; отдельная 499/s — для наглядности. 499 часто от ab/браузера; 504 — fastcgi_read_timeout 60s.",
      "type": "timeseries"
    },
