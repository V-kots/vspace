    "item": [
        {
            "name": "Успешные сценарии",
            "item": [
                {
                    "name": "POST /user/register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"first_name\": \"{{registerFirstName}}\",\n  \"second_name\": \"{{registerSecondName}}\",\n  \"birthdate\": \"1995-05-12\",\n  \"email\": \"{{registerEmail}}\",\n  \"gender\": \"male\",\n  \"biography\": \"Путешествия, музыка\",\n  \"city\": \"Москва\",\n  \"password\": \"your-password\"\n}"
                        },
                        "url": "{{baseUrl}}/user/register",
                        "description": "Регистрация пользователя. Ответ 200: `{ \"user_id\": \"<uuid>\" }`."
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const stamp = Date.now().toString(36);",
                                    "const letters = 'абвгдежзийклмнопрстуфхцчшщ';",
                                    "let tag = '';",
                                    "for (let i = 0; i < 4; i++) {",
                                    "    tag += letters.charAt((stamp.charCodeAt(i % stamp.length) + i) % letters.length);",
                                    "}",
                                    "pm.collectionVariables.set('registerFirstName', 'Имя' + tag);",
                                    "pm.collectionVariables.set('registerSecondName', 'Фам' + tag);",
                                    "pm.collectionVariables.set('registerEmail', `vspace+${stamp}@vspace.loc`);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const json = pm.response.json();",
                                    "pm.test('Has user_id', function () {",
                                    "    pm.expect(json.user_id).to.be.a('string');",
                                    "});",
                                    "pm.collectionVariables.set('userId', json.user_id);",
                                    "pm.environment.set('userId', json.user_id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "POST /login (id + password)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"id\": \"{{userId}}\",\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": "{{baseUrl}}/login",
                        "description": "Аутентификация по OpenAPI: id и password в теле запроса (не в header). Ответ 200: `{ \"token\": \"...\", \"user_id\": \"<uuid>\" }`."
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const userId = pm.variables.get('userId');",
                                    "if (!userId) {",
                                    "    throw new Error('userId пустой — укажите в окружении/CSV или выполните POST /user/register');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Login body: id + password in JSON', function () {",
                                    "    const body = JSON.parse(pm.request.body.raw);",
                                    "    pm.expect(body.id).to.eql(pm.variables.get('userId'));",
                                    "    pm.expect(body.password).to.be.a('string').and.not.empty;",
                                    "});",
                                    "pm.test('Login request has no Bearer header', function () {",
                                    "    pm.expect(pm.request.headers.has('Authorization')).to.be.false;",
                                    "});",
                                    "pm.test('Status 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const json = pm.response.json();",
                                    "pm.test('Has token', function () {",
                                    "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                                    "});",
                                    "pm.collectionVariables.set('token', json.token);",
                                    "pm.environment.set('token', json.token);",
                                    "if (json.user_id) {",
                                    "    pm.collectionVariables.set('userId', json.user_id);",
                                    "    pm.environment.set('userId', json.user_id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "GET /user/get/{id}",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/user/get/{{userId}}",
                        "description": "Получение анкеты. После login — Bearer-токен в заголовке Authorization (как в SPA). Ответ 200: объект User."
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const token = pm.variables.get('token');",
                                    "if (!token) {",
                                    "    throw new Error('token пустой — сначала выполните POST /login');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Authorization Bearer header sent', function () {",
                                    "    const auth = pm.request.headers.get('Authorization');",
                                    "    pm.expect(auth).to.match(/^Bearer .+/);",
                                    "    pm.expect(auth).to.include(pm.variables.get('token'));",
                                    "});",
                                    "pm.test('Status 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const json = pm.response.json();",
                                    "pm.test('Has id', function () {",
                                    "    pm.expect(json.id).to.eql(pm.variables.get('userId'));",
                                    "});",
                                    "const registerFirstName = pm.variables.get('registerFirstName');",
                                    "const csvUserId = pm.iterationData.get('userId');",
                                    "if (registerFirstName && !csvUserId) {",
                                    "    pm.test('Profile names match register', function () {",
                                    "        pm.expect(json.first_name).to.eql(registerFirstName);",
                                    "        pm.expect(json.second_name).to.eql(pm.variables.get('registerSecondName'));",
                                    "    });",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "GET /user/search",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/user/search?first_name={{searchFirstName}}&last_name={{searchLastName}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "user",
                                "search"
                            ],
                            "query": [
                                {
                                    "key": "first_name",
                                    "value": "{{searchFirstName}}",
                                    "description": "Префикс имени"
                                },
                                {
                                    "key": "last_name",
                                    "value": "{{searchLastName}}",
                                    "description": "Префикс фамилии"
                                }
                            ]
                        },
                        "description": "Поиск анкет по префиксу имени и фамилии одновременно. Результат — массив User, отсортированный по id. Используется пользователь, созданный в POST /user/register."
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const first = pm.collectionVariables.get('registerFirstName');",
                                    "const second = pm.collectionVariables.get('registerSecondName');",
                                    "if (!first || !second) {",
                                    "    throw new Error('Сначала выполните POST /user/register');",
                                    "}",
                                    "pm.collectionVariables.set('searchFirstName', first.slice(0, 4));",
                                    "pm.collectionVariables.set('searchLastName', second.slice(0, 3));"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Authorization Bearer header sent', function () {",
                                    "    const auth = pm.request.headers.get('Authorization');",
                                    "    pm.expect(auth).to.match(/^Bearer .+/);",
                                    "    pm.expect(auth).to.include(pm.variables.get('token'));",
                                    "});",
                                    "pm.test('Status 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const json = pm.response.json();",
                                    "pm.test('Response is array', function () {",
                                    "    pm.expect(json).to.be.an('array');",
                                    "});",
                                    "pm.test('Contains registered user', function () {",
                                    "    const userId = pm.collectionVariables.get('userId');",
                                    "    pm.expect(json.some((user) => user.id === userId)).to.be.true;",
                                    "});",
                                    "pm.test('Sorted by id ascending', function () {",
                                    "    const ids = json.map((user) => user.id);",
                                    "    pm.expect(ids).to.eql([...ids].sort());",
                                    "});",
                                    "pm.test('No private fields', function () {",
                                    "    json.forEach((user) => {",
                                    "        pm.expect(user).to.not.have.property('password');",
                                    "        pm.expect(user).to.not.have.property('email');",
                                    "    });",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
