        },
        {
            "name": "Нагрузочный тест: подготовка",
            "item": [
                {
                    "name": "POST /user/register (уникальный пользователь)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"first_name\": \"{{loadRegisterFirstName}}\",\n  \"second_name\": \"{{loadRegisterSecondName}}\",\n  \"birthdate\": \"1995-05-12\",\n  \"email\": \"{{loadRegisterEmail}}\",\n  \"gender\": \"other\",\n  \"biography\": \"Нагрузочный тест\",\n  \"city\": \"Москва\",\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": "{{baseUrl}}/user/register"
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const stamp = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);",
                                    "const letters = 'абвгдежзийклмнопрстуфхцчшщ';",
                                    "let tag = '';",
                                    "for (let i = 0; i < 6; i++) {",
                                    "    tag += letters.charAt((stamp.charCodeAt(i % stamp.length) + i) % letters.length);",
                                    "}",
                                    "pm.collectionVariables.set('loadRegisterFirstName', 'Имя' + tag);",
                                    "pm.collectionVariables.set('loadRegisterSecondName', 'Фам' + tag);",
                                    "pm.collectionVariables.set('loadRegisterEmail', `load+${stamp}@vspace.loc`);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const json = pm.response.json();",
                                    "pm.test('Has user_id', function () {",
                                    "    pm.expect(json.user_id).to.be.a('string');",
                                    "});",
                                    "pm.collectionVariables.set('loadUserId', json.user_id);",
                                    "pm.environment.set('loadUserId', json.user_id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "POST /login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"id\": \"{{loadUserId}}\",\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": "{{baseUrl}}/login"
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const userId = pm.variables.get('loadUserId');",
                                    "if (!userId) {",
                                    "    throw new Error('userId пустой — выполните папку «Подготовка» или POST /user/register');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "pm.test('Login request has no Bearer header', function () {",
                                    "    pm.expect(pm.request.headers.has('Authorization')).to.be.false;",
                                    "});",
                                    "const json = pm.response.json();",
                                    "pm.test('Has token', function () {",
                                    "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                                    "});",
                                    "pm.collectionVariables.set('loadToken', json.token);",
                                    "pm.environment.set('loadToken', json.token);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Нагрузочный тест: нагрузка",
            "item": [
                {
                    "name": "GET /user/search (с Bearer-токеном)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{loadToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/user/search?first_name={{loadFirstName}}&last_name={{loadLastName}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "user",
                                "search"
                            ],
                            "query": [
                                {
                                    "key": "first_name",
                                    "value": "{{loadFirstName}}"
                                },
                                {
                                    "key": "last_name",
                                    "value": "{{loadLastName}}"
                                }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const token = pm.variables.get('loadToken');",
                                    "if (!token) {",
                                    "    throw new Error('token пустой — выполните папку «Подготовка» или POST /login');",
                                    "}",
                                    "const firstNames = ['Иван', 'Пётр', 'Анна', 'Мария', 'Роберт', 'Елена', 'Алексей', 'Ольга', 'Сергей', 'Татьяна'];",
                                    "const lastNames = ['Абрамов', 'Борисова', 'Петров', 'Сидоров', 'Яшина', 'Смирнов', 'Кузнецова', 'Попов', 'Волков', 'Морозова'];",
                                    "const randomOf = (items) => items[Math.floor(Math.random() * items.length)];",
                                    "const prefix = (value, min, max) => value.slice(0, min + Math.floor(Math.random() * (max - min + 1)));",
                                    "pm.collectionVariables.set('loadFirstName', prefix(randomOf(firstNames), 2, 4));",
                                    "pm.collectionVariables.set('loadLastName', prefix(randomOf(lastNames), 2, 4));"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Authorization Bearer header sent', function () {",
                                    "    const auth = pm.request.headers.get('Authorization');",
                                    "    pm.expect(auth).to.match(/^Bearer .+/);",
                                    "    pm.expect(auth).to.include(pm.variables.get('loadToken'));",
                                    "});",
                                    "pm.test('Status 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "pm.test('Response is array', function () {",
