# Copy to .env.docker and adjust for local dev
# docker compose --env-file .env.docker up -d --build

# Имя проекта Compose: префикс контейнеров, сеть ${COMPOSE_PROJECT_NAME}_net
COMPOSE_PROJECT_NAME=vspace

# Каталог данных томов (другой путь — если поднимаете вторую копию с другим COMPOSE_PROJECT_NAME)
COMPOSE_DATA_ROOT=./docker-data

VSPACE_DOMAIN=vspace.loc
GRAFANA_DOMAIN=grafana.vspace.loc
MAIL_DOMAIN=mail.vspace.loc

HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PUBLISH_PORT=5432

POSTGRES_DB=vspace
POSTGRES_USER=vspace
POSTGRES_PASSWORD=secret

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Xdebug 3 (сервис php). off | debug | develop | coverage | ...
XDEBUG_MODE=debug
XDEBUG_CONFIG=client_host=host.docker.internal client_port=9003

# OPcache (load / prod-like по умолчанию). Локальная правка PHP без рестарта: VALIDATE_TIMESTAMPS=1
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
# JIT: 1255 — tracing; 0 — выкл. После смены — docker compose up -d --build php
PHP_OPCACHE_JIT=1255
# Preload bootstrap/preload.php (нужен vendor/). 0 — отключить
PHP_OPCACHE_PRELOAD=1
