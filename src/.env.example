APP_NAME=VSpace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://vspace.loc

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_STDERR_FORMATTER=App\Logging\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_MODE=legacy
DB_HOST=postgres
DB_PORT=5432
DB_READ_PORT=5432
DB_DATABASE=vspace
DB_USERNAME=vspace
DB_PASSWORD=secret
# Реплики чтения (напрямую postgres-replica-*). Пусто — все запросы на мастер.
# Включаются/выключаются через scripts/replication.sh (правит эту строку).
DB_READ_HOSTS=
# DB_READ_HOSTS=postgres-replica-1,postgres-replica-2
# Таймаут подключения к реплике, сек: после него чтение уходит на мастер.
DB_CONNECT_TIMEOUT=2
# Читать с мастера после записи в рамках одного запроса.
DB_STICKY=true

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Кеш ленты постов (Redis ZSET + fan-out + L1). false — обычный запрос в БД.
FEED_CACHE_ENABLED=true
# Сколько последних постов держать в ленте пользователя.
FEED_CACHE_SIZE=1000
# TTL ключа ленты в секундах (по умолчанию 7 дней).
FEED_CACHE_TTL=604800
# L1-кеш главной страницы (5 постов): свежесть и максимальное устаревание, сек.
FEED_PAGE_CACHE_FRESH=2
FEED_PAGE_CACHE_STALE=10

# Кеш тел постов (post:{id}). Отдельно от ленты, по умолчанию выключен.
POST_CACHE_ENABLED=true
POST_CACHE_TTL=3600

# Кеш друзей: список id и профили для /friend/list.
FRIENDS_CACHE_ENABLED=true
FRIENDS_CACHE_TTL=300

# Кеш токенов Sanctum (поиск токена по хешу).
SANCTUM_TOKEN_CACHE_ENABLED=false
SANCTUM_TOKEN_CACHE_TTL=300
# Обновление last_used_at на каждый запрос (лишний UPDATE при кеше токенов).
SANCTUM_LAST_USED_AT=true

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# php-fpm: reuse sockets per worker (avoids EADDRNOTAVAIL under burst traffic)
REDIS_PERSISTENT=true

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=vspace.loc,localhost,127.0.0.1
SESSION_DOMAIN=.vspace.loc
