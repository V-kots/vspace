{
    "openapi": "3.0.0",
    "info": {
        "title": "VSpace API",
        "description": "Реализованные методы социальной сети VSpace (OTUS Highload Architect 1.2.0).\n\nPostman (каталог `api/postman/`): `VSpace.postman_collection.json`, окружение `VSpace.postman_environment.json`.",
        "version": "1.2.0"
    },
    "servers": [
        {
            "url": "https://vspace.loc",
            "description": "Локальное окружение"
        }
    ],
    "paths": {
        "/login": {
            "post": {
                "tags": ["Auth"],
                "summary": "Аутентификация",
                "description": "Передача id пользователя (UUID из регистрации) и пароля. Возвращается Bearer-токен Sanctum.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            },
                            "example": {
                                "id": "e4d2e6b0-cde2-42c5-aac3-0b8316f21e58",
                                "password": "your-password"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успешная аутентификация",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    },
                    "404": {
                        "description": "Пользователь не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        }
                    },
                    "500": {
                        "$ref": "#/components/responses/5xx"
                    },
                    "503": {
                        "$ref": "#/components/responses/5xx"
                    }
                }
            }
        },
        "/user/register": {
            "post": {
                "tags": ["User"],
                "summary": "Регистрация",
                "description": "Создание нового пользователя. Пароль хранится в виде хеша.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            },
                            "example": {
                                "first_name": "Константин",
                                "second_name": "Осипов",
                                "birthdate": "1995-05-12",
                                "email": "pilot@vspace.loc",
                                "gender": "male",
                                "biography": "Путешествия, музыка",
                                "city": "Москва",
                                "password": "your-password"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успешная регистрация",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RegisterResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    },
                    "500": {
                        "$ref": "#/components/responses/5xx"
                    },
                    "503": {
                        "$ref": "#/components/responses/5xx"
                    }
                }
            }
        },
        "/user/get/{id}": {
            "get": {
                "tags": ["User"],
                "summary": "Получение анкеты",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "UUID пользователя",
                        "schema": {
                            "$ref": "#/components/schemas/UserId"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешное получение анкеты",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    },
                    "404": {
                        "description": "Анкета не найдена",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorBody"
                                }
                            }
                        }
                    },
                    "500": {
                        "$ref": "#/components/responses/5xx"
                    },
                    "503": {
                        "$ref": "#/components/responses/5xx"
                    }
                }
            }
        }
    },
    "components": {
        "responses": {
            "400": {
                "description": "Невалидные данные",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorBody"
                        }
                    }
                }
            },
            "5xx": {
                "description": "Ошибка сервера",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorBody"
                        }
                    }
                }
            }
        },
        "schemas": {
            "UserId": {
                "type": "string",
                "format": "uuid",
                "example": "e4d2e6b0-cde2-42c5-aac3-0b8316f21e58"
            },
            "BirthDate": {
                "type": "string",
                "format": "date",
                "example": "1995-05-12"
            },
            "LoginRequest": {
                "type": "object",
                "required": ["id", "password"],
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/UserId"
                    },
                    "password": {
                        "type": "string",
                        "example": "your-password"
                    }
                }
            },
            "LoginResponse": {
                "type": "object",
                "required": ["token"],
                "properties": {
                    "token": {
                        "type": "string",
                        "description": "Bearer-токен Sanctum",
                        "example": "1|7NpUcPoWVk8u9JYLVEr3tmJ55T7Qb8xVViXIdvoJ57d1447b"
                    },
                    "user_id": {
                        "$ref": "#/components/schemas/UserId",
                        "description": "Дополнительное поле для SPA (не обязательно в клиентах OpenAPI)"
                    }
                }
            },
            "RegisterRequest": {
                "type": "object",
                "required": [
                    "first_name",
                    "second_name",
                    "birthdate",
                    "email",
                    "gender",
                    "city",
                    "password"
                ],
                "properties": {
                    "first_name": {
                        "type": "string",
                        "maxLength": 100,
                        "example": "Имя"
                    },
                    "second_name": {
                        "type": "string",
                        "maxLength": 100,
                        "example": "Фамилия"
                    },
                    "birthdate": {
                        "$ref": "#/components/schemas/BirthDate"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "gender": {
                        "type": "string",
                        "enum": ["male", "female", "other"]
                    },
                    "biography": {
                        "type": "string",
                        "example": "Хобби, интересы и т.п."
                    },
                    "city": {
                        "type": "string",
                        "maxLength": 150,
                        "example": "Москва"
                    },
                    "password": {
                        "type": "string",
                        "minLength": 8,
                        "example": "your-password"
                    }
                }
            },
            "RegisterResponse": {
                "type": "object",
                "required": ["user_id"],
                "properties": {
                    "user_id": {
                        "$ref": "#/components/schemas/UserId"
                    }
                }
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/UserId"
                    },
                    "first_name": {
                        "type": "string",
                        "example": "Имя"
                    },
                    "second_name": {
                        "type": "string",
                        "example": "Фамилия"
                    },
                    "birthdate": {
                        "$ref": "#/components/schemas/BirthDate"
                    },
                    "biography": {
                        "type": "string",
                        "example": "Хобби, интересы и т.п."
                    },
                    "city": {
                        "type": "string",
                        "example": "Москва"
                    }
                }
            },
            "ErrorBody": {
                "type": "object",
                "required": ["message"],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Невалидные данные"
                    },
                    "request_id": {
                        "type": "string",
                        "description": "X-Request-Id / request_id middleware"
                    },
                    "code": {
                        "type": "integer",
                        "example": 40001
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "Токен из POST /login (для будущих защищённых методов)"
            }
        }
    }
}
